{
  "schemaVersion": 1,
  "id": "origaitv.steam",
  "name": "Steam",
  "version": "1.0.4",
  "author": "origaitv",
  "license": "MIT",
  "description": "Your Steam games, full screen",
  "kinds": ["tv-app"],
  "entryPoints": { "tvApp": "app.ts" },
  "tv": {
    "contract": 1,
    "category": "games",
    "runtime": "native",
    "icon": "icon.svg",
    "package": { "pacman": "steam" },
    "exec": ["steam", "-gamepadui"],
    "capabilities": ["launch"],
    "childSafe": false
  }
}
