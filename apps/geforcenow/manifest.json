{
  "schemaVersion": 1,
  "id": "origaitv.geforcenow",
  "name": "GeForce NOW",
  "version": "1.0.1",
  "author": "origaitv",
  "license": "MIT",
  "description": "PC games streamed from the cloud",
  "kinds": ["tv-app"],
  "entryPoints": { "tvApp": "app.ts" },
  "tv": {
    "contract": 1,
    "category": "games",
    "runtime": "native",
    "icon": "icon.svg",
    "package": { "flatpak": "com.nvidia.geforcenow" },
    "exec": ["flatpak", "run", "com.nvidia.geforcenow"],
    "capabilities": ["launch"],
    "childSafe": false
  }
}
