{
  "schemaVersion": 1,
  "id": "origaitv.moonlight",
  "name": "Moonlight",
  "version": "1.0.1",
  "author": "origaitv",
  "license": "MIT",
  "description": "Games streamed from your own PC",
  "kinds": ["tv-app"],
  "entryPoints": { "tvApp": "app.ts" },
  "tv": {
    "contract": 1,
    "category": "games",
    "runtime": "native",
    "icon": "icon.svg",
    "package": { "pacman": "moonlight-qt" },
    "exec": ["moonlight"],
    "capabilities": ["launch"],
    "childSafe": false
  }
}
